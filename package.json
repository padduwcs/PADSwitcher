{
  "name": "padswitcher-unix",
  "version": "1.19.1-unix.1",
  "description": "Profile Account Directory Switcher — isolated Linux and macOS edition",
  "private": true,
  "desktopName": "padswitcher-unix.desktop",
  "main": "src/main.cjs",
  "author": "Anh-Duc Phan",
  "license": "MIT",
  "homepage": "https://github.com/padduwcs/PADSwitcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/padduwcs/PADSwitcher.git"
  },
  "bugs": {
    "url": "https://github.com/padduwcs/PADSwitcher/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "codex",
    "kaggle",
    "account-manager",
    "electron",
    "linux",
    "macos"
  ],
  "scripts": {
    "prestart": "node scripts/build-helper.cjs",
    "start": "node scripts/run-electron.cjs .",
    "pretest": "node scripts/build-helper.cjs",
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check.cjs",
    "icons": "node scripts/run-electron.cjs scripts/create-icon.cjs",
    "preview": "node scripts/preview.cjs",
    "smoke": "node scripts/unix-smoke.cjs",
    "smoke:ui": "node scripts/run-electron.cjs scripts/unix-electron-smoke.cjs",
    "smoke:packaged": "node scripts/packaged-unix-smoke.cjs",
    "test:helper": "node scripts/test-helper.cjs",
    "test:kaggle": "node scripts/kaggle-contract.cjs",
    "helper": "node scripts/build-helper.cjs",
    "smoke:protocol": "node scripts/router-protocol-smoke.cjs",
    "smoke:say-hi": "node scripts/say-hi-protocol-smoke.cjs",
    "prebuild": "node scripts/build-helper.cjs",
    "predist": "node scripts/build-helper.cjs",
    "build": "node scripts/package-unix.cjs --dir",
    "dist": "node scripts/package-unix.cjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.1"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "build": {
    "appId": "personal.pad.padswitcher.unix",
    "productName": "PADSwitcher Unix",
    "executableName": "padswitcher-unix",
    "directories": {
      "output": "dist-unix"
    },
    "files": [
      "src/**/*",
      "!src/helper/**/*",
      "!src/assets/PADCodex.exe",
      "!src/core/padkaggle.ps1",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "UNIX-THIRD-PARTY-NOTICES.txt"
    ],
    "asar": true,
    "asarUnpack": [
      "src/assets/PADCodex",
      "src/core/kaggle-reader.py",
      "src/core/padkaggle.sh"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": false
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "src/assets/padswitcher-emblem.png",
      "category": "Development",
      "syncDesktopName": true,
      "artifactName": "PADSwitcher-${version}-Linux-${arch}.${ext}",
      "maintainer": "Anh-Duc Phan"
    },
    "mac": {
      "icon": "src/assets/padswitcher-emblem.png",
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "artifactName": "PADSwitcher-${version}-macOS-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "binaries": ["Contents/Resources/app.asar.unpacked/src/assets/PADCodex"]
    }
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "ws": "8.22.0"
  }
}
