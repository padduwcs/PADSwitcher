{
  "name": "padswitcher",
  "version": "1.12.0",
  "description": "Profile Account Directory Switcher — personal Codex profile manager for Windows",
  "private": true,
  "main": "src/main.cjs",
  "author": "Anh-Duc Phan",
  "license": "MIT",
  "scripts": {
    "prestart": "node scripts/build-helper.cjs",
    "start": "node scripts/run-electron.cjs .",
    "pretest": "node scripts/build-helper.cjs",
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check.cjs",
    "icons": "node scripts/run-electron.cjs scripts/create-icon.cjs",
    "preview": "node scripts/preview.cjs",
    "smoke": "node scripts/smoke.cjs",
    "smoke:ui": "node scripts/run-electron.cjs scripts/electron-smoke.cjs",
    "helper": "node scripts/build-helper.cjs",
    "smoke:gateway": "node scripts/gateway-smoke.cjs --live --inference",
    "smoke:recovery": "node scripts/recovery-native-smoke.cjs --live",
    "smoke:protocol": "node scripts/router-protocol-smoke.cjs",
    "web:build": "node scripts/build-gpt-web.cjs",
    "smoke:web": "node scripts/web-companion-smoke.cjs",
    "prebuild": "node scripts/prepare-build.cjs",
    "predist": "node scripts/prepare-build.cjs",
    "build": "electron-builder --win dir",
    "dist": "electron-builder --win portable",
    "smoke:web:protocol": "node scripts/router-protocol-smoke.cjs --web",
    "smoke:protocol:web-enabled": "node scripts/router-protocol-smoke.cjs --native-with-web",
    "smoke:quota:with-web": "node scripts/quota-regression.cjs",
    "smoke:portable": "node scripts/portable-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.1"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "build": {
    "appId": "personal.pad.padswitcher",
    "productName": "PADSwitcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "artifacts/gpt-web/companion",
        "to": "gpt-web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "src/assets/PADCodex.exe"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "win": {
      "target": "portable",
      "icon": "src/assets/padswitcher.ico",
      "signExecutable": false
    },
    "portable": {
      "unpackDirName": true,
      "artifactName": "PADSwitcher-${version}-Windows.exe"
    }
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "ws": "8.22.0"
  }
}
